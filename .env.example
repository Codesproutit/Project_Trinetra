# Copy to .env and fill in. NEVER commit the real .env.
# BYOK — the tester supplies their own key for the chosen provider.

# Anthropic (Claude) — the first supported provider.
ANTHROPIC_API_KEY=your-key-here

# Optional: override the model tier defaults (all runtime-switchable).
# TRINETRA_MODEL_TRIAGE=claude-haiku-4-5
# TRINETRA_MODEL_REVIEW=claude-sonnet-5
# TRINETRA_MODEL_REASONING=claude-opus-5

# Optional: default per-host request ceiling (safety guardrail).
# TRINETRA_DEFAULT_RPS=10

# Other providers (implemented behind the same interface in later phases):
# OPENAI_API_KEY=
# GEMINI_API_KEY=
